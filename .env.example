# ==============================================================================
# ClientVault — Environment Configuration Template
# ==============================================================================
# Copy this template to .env for local development:
#   cp .env.example .env
#
# NEVER commit the actual .env file or real API keys to version control.
# .env is explicitly excluded in .gitignore.
# ==============================================================================

# LLM / OpenAI API Credentials & Endpoints
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_api_key_here

# Model Selection
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector Database Configuration (ChromaDB / Qdrant)
CHROMA_PERSIST_DIRECTORY=./outputs/chroma_db

# Application Settings
APP_ENV=development
APP_LOG_LEVEL=INFO

# RAG API settings
RAG_API_PORT=8000
# Comma-separated list of allowed frontend origins for CORS (never use * in production)
RAG_API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set to false to use real OpenAI + ChromaDB instead of mock data
RAG_API_FORCE_MOCK=true
RAG_API_THRESHOLD=0.60
# Offline mode only: pause between streamed words on POST /query/stream (live mode streams at model speed)
RAG_API_STREAM_DELAY_MS=40
# Query cache (in-memory, per process)
RAG_API_CACHE_ENABLED=true
RAG_API_CACHE_TTL_S=900
RAG_API_CACHE_MAX_ENTRIES=256
# Structured request log (JSONL); leave empty to log to stdout only
RAG_API_REQUEST_LOG=./outputs/logs/rag_requests.jsonl

# Chat UI (chat-ui/.env.local — Vite only exposes VITE_* variables to the browser; never put secrets here)
# Leave VITE_API_URL unset in dev to use the Vite /api proxy to localhost:8000.
# VITE_API_URL=https://clientvault-api.example.internal
# Abort a stream when no event arrives for this long (ms)
# VITE_STREAM_IDLE_TIMEOUT_MS=20000
