# ==============================================================================
# ClientVault — Environment Configuration Template
# ==============================================================================
# Copy this template to .env for local development:
#   cp .env.example .env
#
# NEVER commit the actual .env file or real API keys to version control.
# .env is explicitly excluded in .gitignore.
# ==============================================================================

# LLM / OpenAI API Credentials & Endpoints
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_api_key_here

# Model Selection
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector Database Configuration (ChromaDB / Qdrant)
CHROMA_PERSIST_DIRECTORY=./outputs/chroma_db

# Application Settings
APP_ENV=development
APP_LOG_LEVEL=INFO
